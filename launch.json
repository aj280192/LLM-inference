{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "streamlit_app.py", "--server.port", "8501"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Pytest: Debug current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ]
}
