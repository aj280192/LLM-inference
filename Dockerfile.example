# Multi-stage build. APP_VERSION baked in via SETUPTOOLS_SCM_PRETEND_VERSION
# so importlib.metadata.version("reportapp") matches the Docker tag's origin.
#
# TODO: pin FROM by digest (FROM python:3.11-slim@sha256:...) once you have
# one, for fully reproducible builds — a moving base-image tag is the one
# gap in build:image's idempotency (see pipeline design notes).

FROM python:3.11-slim AS builder
ARG APP_VERSION
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${APP_VERSION}
RUN pip install --no-cache-dir uv
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY app/ ./app/
COPY streamlit_app.py healthapi.py ./
RUN uv pip install --system .

FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* && useradd --create-home appuser
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
WORKDIR /home/appuser
COPY --chown=appuser streamlit_app.py healthapi.py entrypoint.sh ./
RUN chmod +x entrypoint.sh
USER appuser
EXPOSE 8501 8000
ENTRYPOINT ["./entrypoint.sh"]
