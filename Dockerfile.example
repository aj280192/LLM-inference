# ============================================================================
# Dockerfile — reportapp
# Multi-stage: builder installs deps + app as a wheel; runtime is slim.
# APP_VERSION comes from the pipeline (build:image job) and is baked in via
# SETUPTOOLS_SCM_PRETEND_VERSION so importlib.metadata.version("reportapp")
# always matches what the pipeline computed. See doc 3 + doc 11.
# ============================================================================

# ---------- builder ----------
FROM python:3.11-slim AS builder

ARG APP_VERSION
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${APP_VERSION}

# uv for fast, lockfile-exact installs (matches local dev + CI)
RUN pip install --no-cache-dir uv

WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY app/ ./app/
COPY streamlit_app.py healthapi.py ./
RUN uv pip install --system .

# ---------- runtime ----------
FROM python:3.11-slim

# curl needed for the compose healthcheck; non-root user for security
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home appuser

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /home/appuser
COPY --chown=appuser streamlit_app.py healthapi.py entrypoint.sh ./
RUN chmod +x entrypoint.sh

USER appuser
EXPOSE 8501 8000

ENTRYPOINT ["./entrypoint.sh"]
